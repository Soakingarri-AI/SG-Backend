# =============================================================================
# SoakinGarri AI — Environment Configuration (copy to .env for local dev)
# In AWS, these are injected via ECS task definition secrets / SSM Parameter
# Store / Secrets Manager — never bake secrets into images.
# =============================================================================

# --- Core ---
ENVIRONMENT=development                 # development | staging | production
PROJECT_NAME="SoakinGarri AI"
ROOT_DOMAIN=soakingarri.com

# --- Database (Aurora PostgreSQL + pgvector in prod) ---
POSTGRES_USER=soakingarri
POSTGRES_PASSWORD=soakingarri_dev
POSTGRES_DB=soakingarri
DATABASE_URL=postgresql+asyncpg://soakingarri:soakingarri_dev@postgres:5432/soakingarri

# --- Redis (ElastiCache in prod) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Cookies are scoped to the parent domain so sessions span every subdomain.
COOKIE_DOMAIN=.soakingarri.com
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# New accounts must confirm their email before they can log in. Set false to
# lift the gate (existing accounts were backfilled as verified by migration 0003).
REQUIRE_EMAIL_VERIFICATION=true

# --- Transactional email (Resend) ---
# Unset = emails are logged instead of sent, so local dev needs no credentials.
# RESEND_API is accepted as an alias for RESEND_API_KEY.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM=noreply@soakingarri.com
EMAIL_FROM_NAME=SoakinGarri AI
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=https://www.soakingarri.com/sologo.png
# Base URL for links in emails — must be where the frontend actually runs, and
# it must serve /verify-email and /reset-password routes that read ?token=.
FRONTEND_URL=https://soakingarri-frontend.vercel.app

# --- CORS (comma separated). Locally we allow all *.localhost:3000 origins. ---
CORS_ORIGINS=https://soakingarri.com,https://ask.soakingarri.com,https://examflow.soakingarri.com,https://afrosimulator.soakingarri.com,https://memes.soakingarri.com,https://infiniteparts.soakingarri.com,https://factorizer.soakingarri.com,http://localhost:3000

# --- Rate limiting (Redis token bucket) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# --- AI Provider (Amazon Bedrock in prod; falls back to Anthropic API) ---
AI_PROVIDER=bedrock                     # bedrock | anthropic
AI_MODEL=claude-opus-4-8                # inference model id
AI_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AI_MAX_RETRIES=4
AI_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=soakingarri-assets
S3_PUBLIC_BASE_URL=https://cdn.soakingarri.com     # CloudFront distribution
BEDROCK_REGION=us-east-1

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ROOT_DOMAIN=soakingarri.com

# Contact form delivery. MUST be set before launch or the form returns an honest
# 503 telling senders to email directly (it never silently drops messages).
# Point at an email-provider API, a Slack incoming webhook, or an SES forwarder.
CONTACT_WEBHOOK_URL=
